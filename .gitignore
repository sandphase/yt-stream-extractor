# [YTDown] Seguridad y Privacidad de Usuario
# Ignora archivos locales, datos descargados y binarios especificos del entorno.

# --- Datos de Usuario (IMPORTANTE) ---
downloads/
data/
*.db
*.db-journal
*.sqlite3

# --- Binarios y Herramientas Locales ---
tools/bin/
tools/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# --- Dependencias y Entornos Virtuales ---
node_modules/
dist/
build/
vendor/
venv/
.venv/
env/
.env
.env.local
__pycache__/
*.py[cod]

# --- Inteligencia Artificial ---
# Ignora modelos descargados (Whisper/Spleeter)
.cache/
whisper_models/
*.pt
*.pth

# --- Logs y Temporales ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.aider*
.gemini/

# --- Sistema y Editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
